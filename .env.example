# Copy to .env for local development. Never commit production secrets.
PORT=3001
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ROOM_TTL_HOURS=24
ROOM_PASSWORD_MIN_LENGTH=4
VITE_SOCKET_URL=http://localhost:3001
# MySQL scoring database. Change MYSQL_DATABASE to choose the database name.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=competition_app
MYSQL_PASSWORD=
MYSQL_DATABASE=competition_timer
# Optional alternative connection format; when set, this overrides the settings above.
# MYSQL_URL=mysql://competition_app:change-me@127.0.0.1:3306/competition_timer
# Optional absolute path for uploads; defaults to backend/storage/scoring-media.
# SCORING_MEDIA_DIR=D:\competition-media
